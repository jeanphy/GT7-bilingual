{
  "entities": {
    "Strategy": {
      "title": "Strategy",
      "description": "A saved Gran Turismo 7 endurance race strategy shared across users or stored by an author.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "User-facing strategy title.",
          "minLength": 1,
          "maxLength": 100
        },
        "visibility": {
          "type": "string",
          "description": "Visibility scope of the saved strategy.",
          "enum": ["public"]
        },
        "authorUid": {
          "type": "string",
          "description": "Authenticated author UID.",
          "minLength": 1,
          "maxLength": 128
        },
        "authorName": {
          "type": "string",
          "description": "Public display name of the author (non-PII).",
          "minLength": 1,
          "maxLength": 80
        },
        "trackName": {
          "type": "string",
          "description": "Circuit name.",
          "minLength": 1,
          "maxLength": 120
        },
        "trackLengthKm": {
          "type": "number",
          "description": "Circuit length in kilometers (0 if unspecified)."
        },
        "carName": {
          "type": "string",
          "description": "Car name.",
          "maxLength": 120
        },
        "carCategory": {
          "type": "string",
          "description": "Car category (e.g. Gr.3).",
          "maxLength": 60
        },
        "bopPowerHp": {
          "type": "number",
          "description": "Optional BoP horsepower (0 if omitted)."
        },
        "bopWeightKg": {
          "type": "number",
          "description": "Optional BoP weight in kg (0 if omitted)."
        },
        "mode": {
          "type": "string",
          "description": "Race mode (duration or laps).",
          "enum": ["duration", "laps"]
        },
        "durationInput": {
          "type": "string",
          "description": "Raw duration string (e.g. 1h30).",
          "minLength": 1,
          "maxLength": 30
        },
        "durationMinutes": {
          "type": "number",
          "description": "Race duration in minutes."
        },
        "totalLaps": {
          "type": "integer",
          "description": "Target race lap count."
        },
        "tireWearMultiplier": {
          "type": "number",
          "description": "Informational GT7 tire wear multiplier."
        },
        "fuelMultiplier": {
          "type": "number",
          "description": "Informational GT7 fuel consumption multiplier."
        },
        "pitTransitSeconds": {
          "type": "number",
          "description": "Pit lane transit time in seconds."
        },
        "tireChangeSeconds": {
          "type": "number",
          "description": "Additional tire change duration in seconds."
        },
        "refuelRateLps": {
          "type": "number",
          "description": "Refuel speed in liters per second."
        },
        "fuelPerLapLiters": {
          "type": "number",
          "description": "Fuel consumption per lap in liters."
        },
        "fuelMarginLaps": {
          "type": "number",
          "description": "Safety fuel margin in laps."
        },
        "tires": {
          "type": "object",
          "description": "Map of soft, medium, hard, intermediate, and wet tire specifications."
        },
        "stints": {
          "type": "array",
          "description": "Ordered list of race stints (1 to 50 items)."
        },
        "summary": {
          "type": "object",
          "description": "Computed strategy KPI summary for quick display."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Automatic 10-day expiration timestamp (used for rules enforcement, cleanup, and optional Firestore TTL)."
        }
      },
      "required": [
        "title",
        "visibility",
        "authorUid",
        "authorName",
        "trackName",
        "trackLengthKm",
        "carName",
        "carCategory",
        "bopPowerHp",
        "bopWeightKg",
        "mode",
        "durationInput",
        "durationMinutes",
        "totalLaps",
        "tireWearMultiplier",
        "fuelMultiplier",
        "pitTransitSeconds",
        "tireChangeSeconds",
        "refuelRateLps",
        "fuelPerLapLiters",
        "fuelMarginLaps",
        "tires",
        "stints",
        "summary",
        "createdAt",
        "updatedAt",
        "expiresAt"
      ]
    }
  },
  "firestore": {
    "/strategies/{strategyId}": {
      "schema": {
        "$ref": "#/entities/Strategy"
      },
      "description": "Shared GT7 endurance strategies readable by all users and managed by their verified authors."
    }
  }
}
