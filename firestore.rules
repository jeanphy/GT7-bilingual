rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidTireSpec(t) {
      return t is map &&
        t.keys().hasAll(['enabled', 'lapTimeInput', 'maxLaps', 'mandatory']) &&
        t.keys().hasOnly(['enabled', 'lapTimeInput', 'maxLaps', 'mandatory']) &&
        t.enabled is bool &&
        t.lapTimeInput is string &&
        t.lapTimeInput.size() <= 20 &&
        t.maxLaps is int &&
        t.maxLaps >= 1 &&
        t.maxLaps <= 500 &&
        t.mandatory is bool;
    }

    function isValidTiresMap(tires) {
      return tires is map &&
        tires.keys().hasAll(['soft', 'medium', 'hard', 'intermediate', 'wet']) &&
        tires.keys().hasOnly(['soft', 'medium', 'hard', 'intermediate', 'wet']) &&
        isValidTireSpec(tires.soft) &&
        isValidTireSpec(tires.medium) &&
        isValidTireSpec(tires.hard) &&
        isValidTireSpec(tires.intermediate) &&
        isValidTireSpec(tires.wet);
    }

    function isValidStintItem(st) {
      return st is map &&
        st.keys().hasAll(['compound', 'laps', 'changeTires']) &&
        st.keys().hasOnly(['compound', 'laps', 'changeTires']) &&
        st.compound in ['soft', 'medium', 'hard', 'intermediate', 'wet'] &&
        st.laps is int &&
        st.laps >= 1 &&
        st.laps <= 1000 &&
        st.changeTires is bool;
    }

    function isValidSummary(sum) {
      return sum is map &&
        sum.keys().hasAll(['totalLaps', 'totalStops', 'totalTimeSeconds', 'totalFuelAddedLiters', 'stintsLabel']) &&
        sum.keys().hasOnly(['totalLaps', 'totalStops', 'totalTimeSeconds', 'totalFuelAddedLiters', 'stintsLabel']) &&
        sum.totalLaps is int &&
        sum.totalLaps >= 0 &&
        sum.totalLaps <= 5000 &&
        sum.totalStops is int &&
        sum.totalStops >= 0 &&
        sum.totalStops <= 50 &&
        sum.totalTimeSeconds is number &&
        sum.totalTimeSeconds >= 0 &&
        sum.totalTimeSeconds <= 2000000 &&
        sum.totalFuelAddedLiters is number &&
        sum.totalFuelAddedLiters >= 0 &&
        sum.totalFuelAddedLiters <= 100000 &&
        sum.stintsLabel is string &&
        sum.stintsLabel.size() <= 300;
    }

    function isValidStrategy(data) {
      return data.keys().hasAll([
          'title', 'visibility', 'authorUid', 'authorName',
          'trackName', 'trackLengthKm', 'carName', 'carCategory',
          'bopPowerHp', 'bopWeightKg', 'mode', 'durationInput',
          'durationMinutes', 'totalLaps', 'tireWearMultiplier', 'fuelMultiplier',
          'pitTransitSeconds', 'tireChangeSeconds', 'refuelRateLps',
          'fuelPerLapLiters', 'fuelMarginLaps', 'tires', 'stints',
          'summary', 'createdAt', 'updatedAt', 'expiresAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'visibility', 'authorUid', 'authorName',
          'trackName', 'trackLengthKm', 'carName', 'carCategory',
          'bopPowerHp', 'bopWeightKg', 'mode', 'durationInput',
          'durationMinutes', 'totalLaps', 'tireWearMultiplier', 'fuelMultiplier',
          'pitTransitSeconds', 'tireChangeSeconds', 'refuelRateLps',
          'fuelPerLapLiters', 'fuelMarginLaps', 'tires', 'stints',
          'summary', 'createdAt', 'updatedAt', 'expiresAt'
        ]) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.visibility == 'public' &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorUid == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80 &&
        data.trackName is string && data.trackName.size() >= 1 && data.trackName.size() <= 120 &&
        data.trackLengthKm is number && data.trackLengthKm >= 0 && data.trackLengthKm <= 1000 &&
        data.carName is string && data.carName.size() <= 120 &&
        data.carCategory is string && data.carCategory.size() <= 60 &&
        data.bopPowerHp is number && data.bopPowerHp >= 0 && data.bopPowerHp <= 3000 &&
        data.bopWeightKg is number && data.bopWeightKg >= 0 && data.bopWeightKg <= 5000 &&
        data.mode in ['duration', 'laps'] &&
        data.durationInput is string && data.durationInput.size() >= 1 && data.durationInput.size() <= 30 &&
        data.durationMinutes is number && data.durationMinutes > 0 && data.durationMinutes <= 2000 &&
        data.totalLaps is int && data.totalLaps >= 1 && data.totalLaps <= 1000 &&
        data.tireWearMultiplier is number && data.tireWearMultiplier >= 0 && data.tireWearMultiplier <= 50 &&
        data.fuelMultiplier is number && data.fuelMultiplier >= 0 && data.fuelMultiplier <= 50 &&
        data.pitTransitSeconds is number && data.pitTransitSeconds >= 0 && data.pitTransitSeconds <= 600 &&
        data.tireChangeSeconds is number && data.tireChangeSeconds >= 0 && data.tireChangeSeconds <= 600 &&
        data.refuelRateLps is number && data.refuelRateLps > 0 && data.refuelRateLps <= 100 &&
        data.fuelPerLapLiters is number && data.fuelPerLapLiters > 0 && data.fuelPerLapLiters <= 100 &&
        data.fuelMarginLaps is number && data.fuelMarginLaps >= 0 && data.fuelMarginLaps <= 10 &&
        isValidTiresMap(data.tires) &&
        data.stints is list && data.stints.size() >= 1 && data.stints.size() <= 50 &&
        isValidStintItem(data.stints[0]) &&
        isValidSummary(data.summary) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.expiresAt is timestamp;
    }

    match /strategies/{strategyId} {
      allow get: if isValidId(strategyId) &&
        existing().visibility == 'public' &&
        'expiresAt' in existing() &&
        existing().expiresAt > request.time;

      allow list: if resource.data.visibility == 'public';

      allow create: if isVerifiedUser() &&
        isValidId(strategyId) &&
        isValidStrategy(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().expiresAt > request.time &&
        incoming().expiresAt <= request.time + duration.value(10, 'd');

      allow update: if isVerifiedUser() &&
        isValidId(strategyId) &&
        isValidStrategy(incoming()) &&
        existing().authorUid == request.auth.uid &&
        'expiresAt' in existing() &&
        existing().expiresAt > request.time &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().expiresAt == existing().expiresAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'trackName', 'trackLengthKm', 'carName', 'carCategory',
          'bopPowerHp', 'bopWeightKg', 'mode', 'durationInput', 'durationMinutes',
          'totalLaps', 'tireWearMultiplier', 'fuelMultiplier',
          'pitTransitSeconds', 'tireChangeSeconds', 'refuelRateLps',
          'fuelPerLapLiters', 'fuelMarginLaps', 'tires', 'stints',
          'summary', 'updatedAt'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(strategyId) &&
        (existing().authorUid == request.auth.uid ||
          ('expiresAt' in existing() && existing().expiresAt <= request.time));
    }
  }
}
